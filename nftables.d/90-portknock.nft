# Port knocking for SSH (22), HTTP (80), HTTPS (443). Included into table inet fw4.
# Open:  UDP <KNOCK_PORT_1> -> <KNOCK_PORT_2> -> <KNOCK_PORT_3> (each within 10 s)  => source IP allowed for 1 h idle
# Close: UDP <KNOCK_PORT_3> -> <KNOCK_PORT_2> -> <KNOCK_PORT_1>                     => source IP removed immediately
set knock_o1 { type ipv4_addr; flags timeout; timeout 10s; }
set knock_o2 { type ipv4_addr; flags timeout; timeout 10s; }
set knock_c1 { type ipv4_addr; flags timeout; timeout 10s; }
set knock_c2 { type ipv4_addr; flags timeout; timeout 10s; }
set knock_allowed { type ipv4_addr; flags timeout; timeout 1h; }

chain knock_input {
	type filter hook input priority filter - 5; policy accept;
	ct state established,related accept
	# open sequence
	udp dport <KNOCK_PORT_3> ip saddr @knock_o2 delete @knock_o2 { ip saddr } add @knock_allowed { ip saddr } log prefix "knock-open: " drop
	udp dport <KNOCK_PORT_2> ip saddr @knock_o1 delete @knock_o1 { ip saddr } add @knock_o2 { ip saddr } drop
	# close sequence (reverse)
	udp dport <KNOCK_PORT_1> ip saddr @knock_c2 delete @knock_c2 { ip saddr } delete @knock_allowed { ip saddr } log prefix "knock-close: " drop
	udp dport <KNOCK_PORT_2> ip saddr @knock_c1 delete @knock_c1 { ip saddr } add @knock_c2 { ip saddr } drop
	# first knocks
	udp dport <KNOCK_PORT_1> add @knock_o1 { ip saddr } drop
	udp dport <KNOCK_PORT_3> add @knock_c1 { ip saddr } drop
	# gate
	tcp dport { 22, 80, 443 } ip saddr @knock_allowed update @knock_allowed { ip saddr timeout 1h } accept
	tcp dport { 22, 80, 443 } counter drop
}
