# Drop all IPv6 to, from and through this device (backstop for sysctl disable_ipv6)
chain no_ipv6_in  { type filter hook input   priority filter - 10; policy accept; meta nfproto ipv6 drop; }
chain no_ipv6_out { type filter hook output  priority filter - 10; policy accept; meta nfproto ipv6 drop; }
chain no_ipv6_fwd { type filter hook forward priority filter - 10; policy accept; meta nfproto ipv6 drop; }
