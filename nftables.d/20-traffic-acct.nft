# Per-client traffic counters for the dashboard (read by /etc/traffic-collect.uc).
# Clients sit behind br-lan (car Wi-Fi); the uplink is eth0.2 (WAN cable), formerly phy0-sta0 to the main router.
# out_* = internet, in_* = home network 192.168.1.0/24. down = to the client, up = from it.
set acct_out_down { type ipv4_addr; size 1024; flags dynamic; counter; }
set acct_out_up   { type ipv4_addr; size 1024; flags dynamic; counter; }
set acct_in_down  { type ipv4_addr; size 1024; flags dynamic; counter; }
set acct_in_up    { type ipv4_addr; size 1024; flags dynamic; counter; }

chain traffic_acct {
	type filter hook forward priority filter - 20; policy accept;
	iifname "br-lan" oifname { "phy0-sta0", "eth0.2" } ip daddr != 192.168.1.0/24 add @acct_out_up { ip saddr }
	iifname "br-lan" oifname { "phy0-sta0", "eth0.2" } ip daddr 192.168.1.0/24 add @acct_in_up { ip saddr }
	iifname { "phy0-sta0", "eth0.2" } oifname "br-lan" ip saddr != 192.168.1.0/24 add @acct_out_down { ip daddr }
	iifname { "phy0-sta0", "eth0.2" } oifname "br-lan" ip saddr 192.168.1.0/24 add @acct_in_down { ip daddr }
}
